{
  "expo": {
    "name": "Daypad",
    "slug": "daypad",
    "description": "Tasks, a calculator with a tape, and notes with reminders in one app.",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "daypad",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aylabasha.daypad"
    },
    "android": {
      "package": "com.aylabasha.daypad",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Daypad",
      "shortName": "Daypad",
      "themeColor": "#FAF8F3",
      "backgroundColor": "#FAF8F3",
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 120, "backgroundColor": "#FAF8F3", "dark": { "backgroundColor": "#0E0D14" } }],
      "expo-notifications"
    ]
  }
}
